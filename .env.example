# Plantilla de variables de entorno. Copia este archivo como .env y ajusta los valores.
# El archivo .env NO se sube al repositorio (esta en .gitignore).

# Direccion del servidor de MLflow (opcional).
# Si no se define, los scripts usan http://127.0.0.1:5000 o la carpeta local mlruns.
MLFLOW_TRACKING_URI=http://127.0.0.1:5000